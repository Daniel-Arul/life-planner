# Copy to .env and fill in.
# Generate a key with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
PLANNER_SECRET_KEY=change-me

# Keep true behind `tailscale serve` (HTTPS). Set false only for plain-HTTP local testing.
PLANNER_COOKIE_SECURE=true

# Currency for showing money (ISO 4217 code), e.g. CAD, USD, EUR.
PLANNER_CURRENCY=CAD
